{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "command",
  "checkers": [],
  "mutate": [
    "packages/crosstraining/src/**/*.ts",
    "!packages/crosstraining/src/index.ts"
  ],
  "reporters": [
    "clear-text",
    "json"
  ],
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": null
  },
  "tempDirName": ".stryker-tmp-ct-c1",
  "timeoutMS": 20000,
  "timeoutFactor": 1.5,
  "concurrency": 4,
  "plugins": [],
  "commandRunner": {
    "command": "sh -c 'd=$(mktemp -d -p \"$PWD\" .vt.XXXX); TMPDIR=$d NODE_OPTIONS=--max-old-space-size=1024 timeout -k 2 90 pnpm exec vitest run --config vitest.mutation.crosstraining.config.ts --reporter=dot --bail=1; s=$?; rm -rf \"$d\"; exit $s'"
  },
  "coverageAnalysis": "off",
  "jsonReporter": {
    "fileName": "reports/mutation/crosstraining-c1.json"
  },
  "ignorePatterns": [
    "reports/**",
    "docs/**",
    ".stryker-tmp*/**",
    "apps/**/dist/**",
    "apps/**/dist-single/**",
    "apps/**/node_modules/**"
  ]
}