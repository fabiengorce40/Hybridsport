{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "command",
  "checkers": [],
  "mutate": ["packages/running/src/wave3/guards.ts","packages/running/src/wave3/structure.ts","packages/running/src/wave3/progression.ts","packages/running/src/wave3/first-exposure.ts","packages/running/src/wave3/pace.ts","packages/running/src/wave3/test.ts"],
  "reporters": ["clear-text", "json"],
  "thresholds": { "high": 90, "low": 75, "break": null },
  "tempDirName": ".stryker-tmp-run-gate-g4-wave3",
  "timeoutMS": 20000,
  "timeoutFactor": 1.5,
  "concurrency": 4,
  "plugins": [],
  "commandRunner": {
    "command": "sh -c 'd=$(mktemp -d -p \"$PWD\" .vt.XXXX); TMPDIR=$d NODE_OPTIONS=--max-old-space-size=1024 timeout -k 2 90 pnpm exec vitest run --config vitest.mutation.running.config.ts --reporter=dot --bail=1; s=$?; rm -rf \"$d\"; exit $s'"
  },
  "coverageAnalysis": "off",
  "jsonReporter": { "fileName": "reports/mutation/running-gate-g4-wave3.json" },
  "ignorePatterns": ["reports/**", "docs/**", ".stryker-tmp*/**", "apps/**/dist/**", "apps/**/dist-single/**", "apps/**/node_modules/**"]
}
