{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "command",
  "checkers": [],
  "mutate": [
    "packages/running/src/governance/parameters.ts",
    "packages/running/src/governance/state.ts:50-62"
  ],
  "reporters": [
    "clear-text",
    "json"
  ],
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": null
  },
  "tempDirName": ".stryker-tmp-run-l3",
  "timeoutMS": 10000,
  "timeoutFactor": 1.5,
  "concurrency": 3,
  "plugins": [],
  "commandRunner": {
    "command": "sh -c 'd=$(mktemp -d -p \"$PWD\" .vt.XXXX); TMPDIR=$d NODE_OPTIONS=--max-old-space-size=1024 timeout -k 2 60 pnpm exec vitest run --config vitest.mutation.running.config.ts --reporter=dot; s=$?; rm -rf \"$d\"; exit $s'"
  },
  "coverageAnalysis": "off",
  "jsonReporter": {
    "fileName": "reports/mutation/running-wave1-l3-parameters-maturity.json"
  },
  "ignorePatterns": [
    "reports/**",
    "docs/**",
    ".stryker-tmp*/**"
  ]
}
