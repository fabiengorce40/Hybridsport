{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "command",
  "checkers": [],
  "mutate": [
    "packages/app-core/src/planner.ts",
    "packages/app-core/src/generate.ts",
    "packages/app-core/src/progression.ts",
    "packages/app-core/src/app.ts",
    "packages/app-core/src/store.ts"
  ],
  "reporters": ["clear-text", "json"],
  "thresholds": { "high": 90, "low": 75, "break": null },
  "tempDirName": ".stryker-tmp-kairo",
  "timeoutMS": 15000,
  "timeoutFactor": 1.5,
  "concurrency": 1,
  "plugins": [],
  "commandRunner": {
    "command": "sh -c 'd=$(mktemp -d -p \"$PWD\" .vt.XXXX); TMPDIR=$d NODE_OPTIONS=--max-old-space-size=1024 timeout -k 2 90 pnpm exec vitest run --config vitest.mutation.app-core.config.ts --reporter=dot; s=$?; rm -rf \"$d\"; exit $s'"
  },
  "coverageAnalysis": "off",
  "jsonReporter": { "fileName": "reports/mutation/kairo-app-core-decisions.json" },
  "ignorePatterns": ["reports/**", "docs/**", ".stryker-tmp*/**", "apps/**/dist/**", "apps/**/node_modules/**"]
}
