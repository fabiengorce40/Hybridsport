+/** RC5.3 (étude jetable) — progression individualisée : A (actuel) vs P (prototype), 24 semaines, niveaux × athlètes. */
+import { writeFileSync } from 'node:fs';
+import { it } from 'vitest';
+import { readStrengthParams } from '@hybridsport/strength';
+import { strengthContent } from '../../src/index.js';
+import type { AppState } from '../../src/index.js';
+import type { ProfileSpec } from '../rc4-audit/rc4-sim.js';
+import { measureProfile, summarize } from '../rc46/quality-bench.js';
+import { probe } from '../rc45/probe-starts.js';
+import { rc51Profiles } from '../rc51/rc51-bench.js';
+
+const V = process.env.RC53 === '1' ? (process.env.RC53_R4 === 'soft' ? 'S' : 'P') : 'A';
+const PID = process.env.RC53_PROFILE ?? 'S4';
+const LEVELS = ['beginner', 'intermediate', 'advanced'] as const;
+const KINDS = ['progressant', 'stable', 'fatigue', 'stagnation'] as const;
+// technical-constant: TEST_ONLY — hypothèses de simulation : gain hebdomadaire de capacité (e1RM) par niveau
+const GAIN = { beginner: 0.015, intermediate: 0.0075, advanced: 0.004 } as const;
+// technical-constant: TEST_ONLY — semaines de fatigue (index 0) et baisse de performance ; fin de progression (stagnation)
+const FATIGUE_WEEKS = new Set([2, 3, 10, 11, 18, 19]);
+const FATIGUE_FACTOR = 0.92;
+const STAGNATION_WEEK = 8;
+// technical-constant: TEST_ONLY — charge fictive d'un exercice au poids du corps (modèle de répétitions)
+const BODYWEIGHT_KG = 80;
+const DIV = 30;
+
+function athlete(kind: (typeof KINDS)[number], level: (typeof LEVELS)[number]) {
+  const e0 = new Map<string, number>();
+  const g = GAIN[level];
+  const growth = (w: number) => (kind === 'stable' ? 0 : kind === 'stagnation' ? g * Math.min(w, STAGNATION_WEEK) : g * w);
+  const truth = (ex: string, w: number) => (e0.get(ex) ?? 0) * (1 + growth(w)) * (kind === 'fatigue' && FATIGUE_WEEKS.has(w) ? FATIGUE_FACTOR : 1);
+  return {
+    e0, truth,
+    perform(a: { exerciseId: string; reps: unknown; rir: number | undefined; kg: number | undefined; week: number }) {
+      const load = a.kg ?? BODYWEIGHT_KG;
+      const rirT = a.rir ?? 2;
+      const r = a.reps as number | { min: number; max: number };
+      const lo = typeof r === 'number' ? r : r.min;
+      if (!e0.has(a.exerciseId)) e0.set(a.exerciseId, load * (1 + (lo + rirT) / DIV));
+      const maxR = DIV * (truth(a.exerciseId, a.week) / load - 1);
+      let done = typeof r === 'number' ? Math.min(r, Math.floor(maxR)) : Math.min(r.max, Math.max(r.min, Math.floor(maxR - rirT)));
+      if (done > maxR) done = Math.floor(maxR);
+      return { reps: Math.max(0, done), rir: Math.max(0, Math.floor(maxR - done)) };
+    },
+  };
+}
+
+it(`RC5.3 ${V} ${PID}`, () => {
+  const params = readStrengthParams(strengthContent().ruleset).values;
+  const catalog = strengthContent().catalog;
+  const pct = params['strength.load'].pctByRepsToFailure;
+  const out: Record<string, unknown> = {};
+  const base = rc51Profiles().find((p) => p.id === PID) as ProfileSpec;
+  for (const level of LEVELS) for (const kind of KINDS) {
+    const ath = athlete(kind, level);
+    const spec: ProfileSpec = {
+      ...base, profile: { ...base.profile, level }, athlete: ath,
+      ...(kind === 'fatigue' ? { checkIn: (w: number) => (FATIGUE_WEEKS.has(w) ? { painAnswer: 'no' as const, fatigue: 'high' as const, recovery: 'poor' as const } : { painAnswer: 'no' as const, fatigue: 'low' as const, recovery: 'good' as const }) } : {}),
+    };
+    const snaps: Record<string, AppState> = {};
+    const q = measureProfile(spec, undefined, (st, m) => { if (m === '2026-10-12' || m === '2026-12-28') snaps[m] = st; });
+    const wk = (d: string) => Math.floor((Date.parse(d) - Date.parse('2026-10-05')) / 86_400_000 / 7);
+    // Séquences par (exercice, emplacement) : charge, répétitions, semaine.
+    const seq: Record<string, { w: number; load: number | null; reps: string; main: boolean }[]> = {};
+    for (const s of [...q.sessions].sort((a, b) => (a.date < b.date ? -1 : 1))) for (const i of s.items) (seq[`${i.ex}@${i.slot.split('.').slice(1).join('.')}`] ??= []).push({ w: wk(s.date), load: i.load, reps: i.reps, main: /(^|\.)main_/.test(i.slot) });
+    const stepOf = (ex: string) => { const e = catalog.exercise(`ex.${ex}`); const inc = e?.loadModel ? params['strength.load.defaultIncrements'][e.loadModel] : undefined; return inc ?? 2.5; };
+    const ideal = (ex: string, w: number, reps: number, rir: number) => { const t = ath.truth(`ex.${ex}`, w); const f = pct[String(reps + rir)]; const st = stepOf(ex); return t && f ? Math.floor((t * f) / st + 1e-9) * st : null; };
+    const lifts: Record<string, unknown> = {};
+    let unjustified = 0;
+    for (const [k, L] of Object.entries(seq)) {
+      const [ex] = k.split('@');
+      const loads = L.filter((x) => x.load !== null);
+      let ups = 0; let downs = 0; let repsUps = 0;
+      for (let j = 1; j < L.length; j++) {
+        const a = L[j - 1]!; const b = L[j]!;
+        if (a.load !== null && b.load !== null && b.load > a.load) { ups++; const id = ideal(ex!, b.w, Number(b.reps.split(/[-–]/)[0]), 2); if (id !== null && b.load > id + stepOf(ex!)) unjustified++; }
+        if (a.load !== null && b.load !== null && b.load < a.load) downs++;
+        const lo = (r: string) => Number(r.split(/[-–]/)[0]);
+        if (a.load === b.load && lo(b.reps) > lo(a.reps)) repsUps++;
+      }
+      const at = (wMax: number) => loads.filter((x) => x.w < wMax).at(-1);
+      const err = (wMax: number) => { const x = at(wMax); if (!x || x.load === null || !L[0]?.main) return null; const id = ideal(ex!, x.w, Number(x.reps.split(/[-–]/)[0]), 2); return id ? Math.round(((x.load - id) / id) * 1000) / 10 : null; };
+      // Écart de capacité IMPLICITE de la prescription (charge × (1 + (reps + 2) / 30)) à la capacité réelle (accessoires chargés).
+      const cap = (wMax: number) => { const x = L.filter((y) => y.w < wMax && y.load !== null).at(-1); const t = x ? ath.truth(`ex.${ex}`, x.w) : 0; return x && t ? Math.round(((x.load! * (1 + (Number(x.reps.split(/[-–]/)[0]) + 2) / DIV)) / t - 1) * 1000) / 10 : null; };
+      lifts[k] = { capErr12: cap(12), capErr24: cap(24), n: L.length, main: L[0]?.main ?? false, first: loads[0]?.load ?? null, w12: at(12)?.load ?? null, w24: at(24)?.load ?? null, reps12: L.filter((x) => x.w < 12).at(-1)?.reps, reps24: L.at(-1)?.reps, ups, downs, repsUps, err12: err(12), err24: err(24), seq: L.map((x) => `${x.w}:${x.load ?? '-'}x${x.reps}`) };
+    }
+    const audit = (q.state?.programmeState?.audit ?? []).map((a) => a.reason);
+    const codes: Record<string, number> = {};
+    for (const r of audit) if (r.code.startsWith('PROGRESSION.') || r.code.startsWith('DOSE.')) { const key = r.code === 'PROGRESSION.HELD' ? `HELD:${String(r.params.cause)}` : r.code === 'PROGRESSION.ADVANCED' ? `ADVANCED:${String(r.params.variable)}` : r.code === 'PROGRESSION.REEVALUATED' ? `REEVALUATED:${String(r.params.cause)}` : r.code; codes[key] = (codes[key] ?? 0) + 1; }
+    const dec = (st?: AppState) => { const o: Record<string, number> = {}; if (st) for (const [k, v] of Object.entries(probe(st))) { const kk = `${k.split('|')[1] ?? ''}:${v.decision}`; o[kk] = (o[kk] ?? 0) + 1; } return o; };
+    // Volume par semaine (planifié vs plancher / haut) avec la semaine de décharge du prototype (P seulement).
+    const L = { beginner: 6, intermediate: 5, advanced: 4 }[level];
+    const deload = (w: number) => V !== 'A' && w % L === L - 1;
+    let underNoDeload = 0; let underDeload = 0; let overNoDeload = 0;
+    for (const w of q.weeks) for (const v of Object.values(w.vol)) {
+      const [pl, fl, hi] = v as readonly [number, number | null, number | null];
+      if (fl !== null && pl < fl) { if (deload(w.week - 1)) underDeload++; else underNoDeload++; }
+      if (hi !== null && pl > hi && !deload(w.week - 1)) overNoDeload++;
+    }
+    const tierOf = new Map((q.state?.strength.tracks ?? []).map((t) => [t.trackId, t.tier]));
+    const regByTier: Record<string, number> = {};
+    for (const r of audit) if (r.code === 'PROGRESSION.REGRESSED') { const k2 = tierOf.get(String(r.params.trackId)) ?? '?'; regByTier[k2] = (regByTier[k2] ?? 0) + 1; }
+    // TA-07 : essais annulés par track et par cycle (maximum observé).
+    const revertsBy: Record<string, number> = {};
+    for (const a of q.state?.programmeState?.audit ?? []) if (a.reason.code === 'PROGRESSION.PROBE_REVERTED') { const k3 = `${String(a.reason.params.trackId)}@${String(Math.floor((a.weekIndex ?? 0) / L))}@${String(a.reason.params.fromKg)}`; revertsBy[k3] = (revertsBy[k3] ?? 0) + 1; }
+    out[`${level}/${kind}`] = { underNoDeload, underDeload, overNoDeload, regByTier, maxRevertsPerLoadCycle: Math.max(0, ...Object.values(revertsBy)), summary: summarize(q), lifts, codes, unjustified, probes: { w2: dec(snaps['2026-10-12']) }, sessions: q.sessions.length };
+  }
+  writeFileSync(`${process.env.RC53_OUT}/${V}-${PID}.json`, JSON.stringify(out));
+}, 7_200_000);
