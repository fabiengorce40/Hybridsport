+/** RC5.3 (étude) — TA-18 : états existants (BÊTA e2cdcc5 = pré-RC5.1, et RC5.1) relus par le prototype sans perte. */
+import { readdirSync, readFileSync, writeFileSync, mkdirSync } from 'node:fs';
+import { createHash } from 'node:crypto';
+import { it } from 'vitest';
+import { ensureBeta0Week, exportState, loadState, MemoryStorage, saveState, selectBeta0Week, selectHistory, STORAGE_KEY } from '../../src/index.js';
+import { simulate } from '../rc4-audit/rc4-sim.js';
+import { rc51Profiles } from '../rc51/rc51-bench.js';
+
+const D = '/tmp/claude-0/beta-compat';
+const R51 = '/tmp/claude-0/rc51-states';
+it('conservation', () => {
+  if (process.env.RC53 !== '1' && process.env.RC53_GEN === '1') {
+    // Génération par le code RC5.1 actuel (A) : S4 et P1b après 3 semaines, tracks par archétype A/B.
+    mkdirSync(R51, { recursive: true });
+    for (const id of ['S4', 'P1b', 'S4D']) {
+      const r = simulate(rc51Profiles().find((p) => p.id === id)!, 3);
+      const st = new MemoryStorage(); saveState(st, r.state);
+      writeFileSync(`${R51}/${id}.json`, st.getItem(STORAGE_KEY) ?? '');
+    }
+    return;
+  }
+  const out: string[] = [];
+  for (const [dir, files] of [[D, readdirSync(D).filter((f) => f.endsWith('.json'))], [R51, readdirSync(R51)]] as const) {
+    for (const f of files) {
+      const raw = readFileSync(`${dir}/${f}`, 'utf8');
+      const st = new MemoryStorage(); st.setItem(STORAGE_KEY, raw);
+      const r = loadState(st, '2026-10-26T07:00:00.000Z');
+      if (r.status !== 'ok') { out.push(`${f} LOAD ${r.status}`); continue; }
+      const st2 = new MemoryStorage(); saveState(st2, r.state);
+      const same = st2.getItem(STORAGE_KEY) === raw;
+      const weeks = Object.keys(r.state.planner.weeks);
+      const hist = JSON.stringify(selectHistory(r.state)).length;
+      let next = 'n/a';
+      try { const n = ensureBeta0Week(r.state, { today: '2026-10-26', now: '2026-10-26T07:00:00.000Z' }); const kept = createHash('sha256').update(JSON.stringify(weeks.map((w) => n.planner.weeks[w]))).digest('hex').slice(0, 12); next = `planned=${String(Boolean(selectBeta0Week(n, '2026-10-26')))} anciennesSemaines#=${String(kept)} tracks=${n.strength.tracks.filter((t) => t.status === 'active').length}`; } catch (e) { next = `ERREUR ${(e as Error).message}`; }
+      out.push(`${dir.split('/').at(-1)}/${f} migré=${String(r.migratedFrom ?? '-')} réécritIdentique=${String(same)} historique=${hist} ${next} export=${exportState(r.state).length}`);
+    }
+  }
+  writeFileSync(process.env.OUT!, out.join('\n'));
+}, 1_800_000);
