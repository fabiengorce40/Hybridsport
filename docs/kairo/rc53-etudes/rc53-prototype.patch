@@ -0,0 +1,27 @@
+/**
+ * RC5.3 (PROTOTYPE, `RC53=1`) — mésocycles : durée par niveau (4 à 6 semaines, surchargeable par `RC53_MESO`), position
+ * dérivée de la semaine du programme (déterministe, aucun état ajouté), dernière semaine = décharge.
+ */
+import { weekIndexOf } from '@hybridsport/programme';
+import type { AppState } from './model.js';
+
+export const rc53 = (): boolean => process.env.RC53 === '1';
+// technical-constant: PROTOTYPE — durées initiales par niveau (semaines)
+const LENGTH: Record<string, number> = { novice: 6, beginner: 6, intermediate: 5, advanced: 4 };
+
+export function mesocycleLength(level: string): number {
+  const o = Number(process.env.RC53_MESO);
+  // technical-constant: PROTOTYPE — bornes de la durée configurable (semaines)
+  return Number.isInteger(o) && o >= 4 && o <= 6 ? o : (LENGTH[level] ?? 5);
+}
+
+export interface MesoPosition { readonly week: number; readonly pos: number; readonly length: number; readonly deload: boolean }
+
+export function mesoPosition(state: AppState, date: string): MesoPosition | undefined {
+  if (!rc53() || !state.programmeState || !state.profile) return undefined;
+  const week = weekIndexOf(state.programmeState, date);
+  if (week < 0) return undefined;
+  const length = mesocycleLength(state.profile.level);
+  const pos = week % length;
+  return { week, pos, length, deload: pos === length - 1 };
+}
