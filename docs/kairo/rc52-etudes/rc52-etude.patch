@@ -0,0 +1,37 @@
+/** RC5.2 (étude jetable) — progression Haut A/B et Bas A/B : variantes REF / A / B1 / B2 / C, 12 semaines. */
+import { writeFileSync } from 'node:fs';
+import { it } from 'vitest';
+import type { AppState } from '../../src/index.js';
+import type { ProfileSpec } from '../rc4-audit/rc4-sim.js';
+import { measureProfile, summarize } from '../rc46/quality-bench.js';
+import { probe } from '../rc45/probe-starts.js';
+import { rc51Profiles } from '../rc51/rc51-bench.js';
+
+const V = process.env.RC52_VARIANT ?? 'A';
+const IDS = (process.env.RC52_PROFILES ?? 'S4,P1b,S4H,S4C,S4D').split(',');
+const count = (xs: string[]) => { const o: Record<string, number> = {}; for (const x of xs) o[x] = (o[x] ?? 0) + 1; return o; };
+it(`étude ${V}`, () => {
+  const out: Record<string, unknown> = {};
+  for (const id of IDS) for (const athlete of ['conforme', 'progressant'] as const) {
+    const base = rc51Profiles().find((p) => p.id === id) as ProfileSpec;
+    const spec: ProfileSpec = { ...base, ...(athlete === 'progressant' ? { rirOffset: 2 } : {}) };
+    const snaps: Record<string, AppState> = {};
+    const q = measureProfile(spec, undefined, (st, m) => { if (m === '2026-10-12' || m === '2026-11-16') snaps[m] = st; });
+    const seq: Record<string, { w: string; load: number | null; reps: string; sets: number; slot: string; arch: string }[]> = {};
+    for (const s of [...q.sessions].sort((a, b) => (a.date < b.date ? -1 : 1))) for (const i of s.items) (seq[`${i.ex}@${i.slot.split('.').slice(1).join('.')}`] ??= []).push({ w: s.week, load: i.load, reps: i.reps, sets: i.sets, slot: i.slot, arch: s.arch });
+    const lifts = Object.fromEntries(Object.entries(seq).map(([ex, L]) => {
+      const loads = L.map((x) => x.load);
+      let up = 0; let firstUp: string | null = null; let repsUp = 0;
+      for (let k = 1; k < L.length; k++) {
+        const a = L[k - 1]!; const b = L[k]!;
+        if (a.load !== null && b.load !== null && b.load > a.load) { up++; firstUp ??= b.w; }
+        const lo = (r: string) => Number(r.split(/[-–]/)[0]);
+        if (a.load !== null && a.load === b.load && lo(b.reps) > lo(a.reps)) repsUp++;
+      }
+      return [ex, { n: L.length, perWeek: Math.round((L.length / 12) * 100) / 100, first: loads.find((x) => x !== null) ?? null, last: loads.filter((x) => x !== null).at(-1) ?? null, loadUps: up, firstLoadUpWeek: firstUp, repsUps: repsUp, sets: L.reduce((t, x) => t + x.sets, 0), seq: L.map((x) => `${x.load ?? '-'}x${x.reps}`) }];
+    }));
+    const dec = (st?: AppState) => (st ? count(Object.entries(probe(st)).map(([k, v]) => `${k.split('|')[1]}:${v.decision}`)) : {});
+    out[`${id}/${athlete}`] = { summary: summarize(q), lifts, probes: { w2: dec(snaps['2026-10-12']), w7: dec(snaps['2026-11-16']) }, archs: count(q.sessions.map((s) => s.arch)) };
+  }
+  writeFileSync(`${process.env.RC52_OUT}/rc52-${V}.json`, JSON.stringify(out, null, 1));
+}, 3_600_000);
