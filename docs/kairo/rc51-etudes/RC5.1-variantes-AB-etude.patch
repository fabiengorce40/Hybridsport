+    simulate(spec, 2, beta0Environment(), (st, monday) => { if (monday === '2026-10-12') w2 = st; });
+    const pr = probe(w2 as never);
+    out[`${spec.id}:probe`] = pr;
+  }
+  writeFileSync(`/tmp/claude-0/-home-user-Hybridsport/f083cc76-61a7-573c-85c7-94efc86a17c0/scratchpad/rc51-more-${process.env.RC51_VARIANT || '0'}${process.env.RC51_MIGRATE ? 'M' : ''}.json`, JSON.stringify(out));
+}, 900000);
