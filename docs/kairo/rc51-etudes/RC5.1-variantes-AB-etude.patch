diff --git a/packages/strength/tests/fixtures/rc51.ts b/packages/strength/tests/fixtures/rc51.ts
new file mode 100644
index 0000000..2f6b6d5
--- /dev/null
+++ b/packages/strength/tests/fixtures/rc51.ts
@@ -0,0 +1,72 @@
+/** RC5.1 — ÉTUDE (copie jetable) : Haut A/B et Bas A/B explicites, surcouche du ruleset L1b-4. Variante par RC51_VARIANT. */
+import type { RulesetDocumentInput } from '@hybridsport/domain';
+import { strengthL1B4RulesetDocument } from './l1b4.js';
+
+type Json = Record<string, unknown>;
+export const RC51_VARIANT = (globalThis as { process?: { env?: Record<string, string | undefined> } }).process?.env?.RC51_VARIANT ?? '';
+
+function slotOf(a: Json, id: string): Json {
+  const s = (a.slots as Json[]).find((x) => x.id === id);
+  if (!s) throw new Error(id);
+  return s;
+}
+const strip = ({ choiceGroup: _c, ...rest }: Json): Json => rest;
+const mk = (src: Json, id: string, o: Json): Json => ({ ...strip(src), id, ...o });
+
+/** Variante C : groupes de choix CONSERVÉS (repli douleur / matériel), membre PRÉFÉRÉ par archétype A ou B. */
+function variantC(upper: Json, lower: Json): Json[] {
+  const pref = (a: Json, prefix: string, preferred: Record<string, string>): Json => ({
+    ...a, id: a.id === 'str_upper' ? `str_upper_${prefix}` : `str_lower_${prefix}`,
+    slots: (a.slots as Json[]).map((s) => {
+      const id = String(s.id).replace(/^(up|lo)\./, `${a.id === 'str_upper' ? 'u' : 'l'}${prefix}.`);
+      const g = s.choiceGroup as string | undefined;
+      return { ...s, id, ...(g && preferred[g] === s.need ? { preferred: true } : {}) };
+    }),
+  });
+  return [
+    pref(upper, 'a', { main: 'push_horizontal', pull: 'pull_vertical', push_2: 'push_vertical', pull_2: 'pull_horizontal' }),
+    pref(upper, 'b', { main: 'push_vertical', pull: 'pull_horizontal', push_2: 'push_horizontal', pull_2: 'pull_vertical' }),
+    pref(lower, 'a', { main: 'knee_dominant', secondary: 'hip_dominant' }),
+    pref(lower, 'b', { main: 'hip_dominant', secondary: 'knee_dominant' }),
+  ];
+}
+
+export function rc51Archetypes(upper: Json, lower: Json, variant: string): Json[] {
+  if (variant === 'C') return variantC(upper, lower);
+  const U = (id: string) => slotOf(upper, id);
+  const L = (id: string) => slotOf(lower, id);
+  const loadSec = variant === 'B';
+  const ua = { ...upper, id: 'str_upper_a', slots: [
+    mk(U('up.main_push_h'), 'ua.main_push_h', {}),
+    mk(U('up.pull_v'), 'ua.pull_v', {}),
+    loadSec ? mk(U('up.pull_h'), 'ua.push_v', { need: 'push_vertical', blockId: 'b.secondary', role: 'secondary' }) : mk(U('up.push_2v'), 'ua.push_v', {}),
+    mk(U('up.pull_2h'), 'ua.pull_h', {}),
+    mk(U('up.iso_upper'), 'ua.iso_upper', {}), mk(U('up.trunk'), 'ua.trunk', {}),
+  ] };
+  const ub = { ...upper, id: 'str_upper_b', slots: [
+    mk(U('up.main_push_v'), 'ub.main_push_v', {}),
+    mk(U('up.pull_h'), 'ub.pull_h', {}),
+    loadSec ? mk(U('up.pull_h'), 'ub.push_h', { need: 'push_horizontal', blockId: 'b.secondary', role: 'secondary' }) : mk(U('up.push_2h'), 'ub.push_h', {}),
+    mk(U('up.pull_2v'), 'ub.pull_v', {}),
+    mk(U('up.iso_upper'), 'ub.iso_upper', {}), mk(U('up.trunk'), 'ub.trunk', {}),
+  ] };
+  const rest = (p: string) => (lower.slots as Json[]).filter((s) => ['lo.single_leg', 'lo.iso_lower', 'lo.trunk', 'lo.calves'].includes(String(s.id))).map((s) => mk(s, String(s.id).replace('lo.', `${p}.`), {}));
+  const la = { ...lower, id: 'str_lower_a', slots: [mk(L('lo.main_knee'), 'la.main_knee', {}), mk(L('lo.sec_hip'), 'la.sec_hip', {}), ...rest('la')] };
+  const lb = { ...lower, id: 'str_lower_b', slots: [mk(L('lo.main_hip'), 'lb.main_hip', {}), mk(L('lo.sec_knee'), 'lb.sec_knee', {}), ...rest('lb')] };
+  return [ua, ub, la, lb];
+}
+
+export function strengthRc51RulesetDocument(): RulesetDocumentInput {
+  const base = strengthL1B4RulesetDocument();
+  return {
+    ...base,
+    rulesetVersion: `0.8.0-strength-rc51-${RC51_VARIANT || 'none'}`,
+    parameters: base.parameters.map((p) => {
+      if (p.id !== 'strength.archetypes' || !RC51_VARIANT) return p;
+      const arr = p.value as unknown as Json[];
+      const upper = arr.find((a) => a.id === 'str_upper') as Json;
+      const lower = arr.find((a) => a.id === 'str_lower') as Json;
+      return { ...p, value: [...arr, ...rc51Archetypes(upper, lower, RC51_VARIANT)] as unknown as typeof p.value, version: '0.8.0' };
+    }),
+  };
+}
