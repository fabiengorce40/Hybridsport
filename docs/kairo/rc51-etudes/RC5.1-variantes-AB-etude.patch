+it('more', () => {
+  const out: Record<string, unknown> = {};
+  const specs = qualityProfiles().filter((p) => ['S4', 'P1b'].includes(p.id)) as ProfileSpec[];
+  for (const spec of specs) {
+    const q = measureProfile(spec);
+    out[`${spec.id}:loads`] = q.sessions.map((s) => ({ w: s.week, arch: s.arch, items: s.items.filter((i) => /main|sec_|pull_v|pull_h|push_v|push_h/.test(i.slot)).map((i) => [i.slot, i.ex, i.sets, i.reps, i.load]) }));
