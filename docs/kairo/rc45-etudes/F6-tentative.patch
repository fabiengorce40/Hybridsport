+/**
+ * RC4.5 (F6) — volume de la SEMAINE PLANIFIÉE par groupe : séances Strength de la semaine transmises par le planificateur
+ * (réalisées ou non, séries prévues) + cette séance jusqu'ici (séries minimales du profil, comme `volume_fit`). Jamais la
+ * fenêtre glissante de 7 jours (qui compterait la semaine précédente) : base identique à la planification et au démarrage.
+ */
+function weekVolume(env: Env, soFar: SessionSoFar): Record<string, number> {
+  const roleOf = (slotId: string) => env.archetype.slots.find((x) => x.id === slotId)?.role ?? 'accessory';
+  const out: Record<string, number> = { ...plannedHardSets(soFar.chosen.map((x) => ({ exercise: x.exercise, workingSets: doseCell(x.exercise, roleOf(x.slotId), env).cell.sets.min })), env) };
+  for (const s of env.input.discipline.week.otherStrengthSessions) for (const [g, n] of Object.entries(s.plannedHardSets)) out[g] = (out[g] ?? 0) + n;
+  return out;
+}
