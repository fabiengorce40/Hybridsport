+/** RC4.5 (F6) — déficit relatif le plus grand parmi les groupes PRIMAIRES d'un candidat : (cible − semaine) / cible. */
+export function primaryDeficit(e: Exercise, env: Env, week: Readonly<Record<string, number>>): { readonly deficit: number; readonly group: string | null; readonly projected: number; readonly target: number } {
+  let best = { deficit: 0, group: null as string | null, projected: 0, target: 0 };
+  for (const g of groupsOf(e, env).primary) {
+    const t = weeklyTarget(g, env);
+    const total = week[g] ?? 0;
+    if (!t || t.floor <= 0 || total >= t.floor) continue;
+    const d = (t.floor - total) / t.floor;
+    if (d > best.deficit) best = { deficit: d, group: g, projected: total, target: t.floor };
+  }
+  return best;
+}
+
+/**
+ * RC4.5 (F6) — candidat de l'emplacement qui réduit un déficit, quand l'exercice retenu ne sert que des groupes DÉJÀ à
+ * leur cible dans la semaine (ne pas nuire), sous les garde-fous de `strength.selection.deficitOrientation` : aucun groupe (primaire ou secondaire) porté au-delà
+ * de sa borne haute, `fatigue_fit` au moins égal (structures à ménager, douleur, charge axiale), pas plus de séries au
+ * profil, pas plus lent (mise en place, temps par répétition). Parmi plusieurs, le plus grand déficit, puis l'ordre du
+ * classement. Sinon `undefined`.
+ */
+export function deficitOrientedPick(chosen: Ranked, ranked: readonly Ranked[], slot: SlotInstance, env: Env, soFar: SessionSoFar): { readonly pick: Ranked; readonly to: ReturnType<typeof primaryDeficit>; readonly from: ReturnType<typeof primaryDeficit> } | undefined {
+  const role = slot.def.role;
+  const week = weekVolume(env, soFar);
+  const from = primaryDeficit(chosen.exercise, env, week);
+  // Ne pas nuire : seuls les emplacements dont l'exercice retenu sert des groupes DÉJÀ à leur cible cette semaine sont
+  // réorientés (aucune série retirée à un groupe encore sous sa cible).
+  if (from.deficit > 0) return undefined;
+  const fatigue = (e: Exercise) => criterionValue('fatigue_fit', e, slot, env, soFar);
+  const sets = (e: Exercise) => doseCell(e, role, env).cell.sets.min;
+  const exceedsHigh = (e: Exercise): boolean => Object.entries(plannedHardSets([{ exercise: e, workingSets: sets(e) }], env))
+    .some(([g, n]) => { const t = weeklyTarget(g, env); return t !== undefined && n > 0 && (week[g] ?? 0) + n > t.high; });
+  let best: { pick: Ranked; to: ReturnType<typeof primaryDeficit> } | undefined;
+  for (const r of ranked) {
+    if (r.exercise.id === chosen.exercise.id) continue;
+    const to = primaryDeficit(r.exercise, env, week);
+    if (to.deficit <= from.deficit || (best && to.deficit <= best.to.deficit)) continue;
+    if (exceedsHigh(r.exercise)) continue;
+    if (compareLex(fatigue(r.exercise), fatigue(chosen.exercise)) < 0) continue;
+    if (sets(r.exercise) > sets(chosen.exercise)) continue;
+    // Temps disponible : jamais plus lent que l'exercice remplacé (mise en place, temps par répétition), pour ne pas
+    // évincer un autre exercice de la séance par la contrainte de durée.
+    // Temps par répétition inconnu : impossible de prouver qu'il n'est pas plus lent ⇒ candidat écarté.
+    if (r.exercise.timing.setupS > chosen.exercise.timing.setupS || (r.exercise.timing.secondsPerRep?.typical ?? Infinity) > (chosen.exercise.timing.secondsPerRep?.typical ?? 0)) continue;
+    best = { pick: r, to };
+  }
+  return best ? { ...best, from } : undefined;
+}
