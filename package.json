{
  "name": "hybridsport",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/kairo/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:mutation": "stryker run",
    "kairo:dev": "pnpm --filter @hybridsport/kairo dev",
    "kairo:build": "pnpm --filter @hybridsport/kairo build",
    "kairo:preview": "pnpm --filter @hybridsport/kairo preview",
    "kairo:e2e": "node apps/kairo/scripts/e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
