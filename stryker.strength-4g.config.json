{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "command",
  "checkers": [],
  "mutate": [
    "packages/strength/src/stimulus-preservation.ts",
    "packages/strength/src/engine.ts:402-439"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": null
  },
  "tempDirName": ".stryker-tmp-4g",
  "timeoutMS": 60000,
  "concurrency": 4,
  "plugins": [],
  "commandRunner": {
    "command": "pnpm exec vitest run --config vitest.mutation.strength.config.ts --reporter=dot"
  },
  "coverageAnalysis": "off",
  "jsonReporter": {
    "fileName": "reports/mutation/strength-4g-mutation.json"
  }
}
