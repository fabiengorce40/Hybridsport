{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "command",
  "checkers": [],
  "mutate": [
    "packages/engine/src/decision/**/*.ts",
    "packages/engine/src/rules/enforcement.ts",
    "packages/engine/src/rules/governance.ts",
    "packages/engine/src/duration/tolerance.ts",
    "packages/engine/src/safety/**/*.ts"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": null
  },
  "tempDirName": ".stryker-tmp",
  "timeoutMS": 60000,
  "concurrency": 2,
  "plugins": [],
  "commandRunner": {
    "command": "pnpm exec vitest run --config vitest.mutation.config.ts --reporter=dot"
  },
  "coverageAnalysis": "off",
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  }
}
