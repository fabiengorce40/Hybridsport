{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts",
    "related": false
  },
  "checkers": [],
  "mutate": [
    "packages/engine/src/decision/**/*.ts",
    "packages/engine/src/rules/enforcement.ts",
    "packages/engine/src/rules/governance.ts",
    "packages/engine/src/duration/tolerance.ts",
    "packages/engine/src/safety/**/*.ts"
  ],
  "reporters": [
    "clear-text",
    "progress"
  ],
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": null
  },
  "tempDirName": ".stryker-tmp",
  "timeoutMS": 60000,
  "concurrency": 2,
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ]
}
